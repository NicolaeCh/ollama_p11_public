# Container engine and Compose implementation
CONTAINER_RUNTIME=podman
COMPOSE_COMMAND=auto
COMPOSE_PROJECT_NAME=ollama-p11

# Ollama container
CONTAINER_NAME=ollama-ppc64le
OLLAMA_IMAGE=icr.io/ppc64le-oss/ollama-ppc64le:v0.17.6
OLLAMA_HOST_BIND=0.0.0.0
OLLAMA_API_HOST=127.0.0.1
OLLAMA_PORT=11434
OLLAMA_MODELS_DIR=./models
OLLAMA_KEEP_ALIVE=10m
OLLAMA_ORIGINS=*
OLLAMA_CONTEXT_LENGTH=16384

# Inference threads requested by the supplied Streamlit application and tests.
# Ollama does not provide a global server environment variable for num_thread;
# clients must send options.num_thread or use a model created with that parameter.
OLLAMA_NUM_THREADS=16

# Container CPU quota. Keep this equal to or greater than OLLAMA_NUM_THREADS.
OLLAMA_CONTAINER_CPUS=16

# Ollama scheduling/concurrency settings (not inference thread count)
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=64
OLLAMA_DEBUG=1

# Streamlit
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8505

# Network names
OLLAMA_NETWORK_NAME=ollama-net-local
N8N_NETWORK_NAME=n8n-ppc64le_n8n_net

# Optional proxy settings
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost,ollama,ollama-ppc64le
