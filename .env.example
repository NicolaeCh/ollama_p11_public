CONTAINER_RUNTIME=podman
CONTAINER_NAME=ollama-ppc64le
OLLAMA_IMAGE=quay.io/andre_lutz/ollama-ppc64le
OLLAMA_HOST_BIND=0.0.0.0
OLLAMA_API_HOST=127.0.0.1
OLLAMA_PORT=11434
STREAMLIT_HOST=0.0.0.0
STREAMLIT_PORT=8505
PROJECT_DIR=${HOME}/ollama-project
OLLAMA_MODELS_DIR=${HOME}/ollama-project/models
OLLAMA_KEEP_ALIVE=10m
OLLAMA_ORIGINS=*
OLLAMA_CONTEXT_LENGTH=16384
OLLAMA_NUM_THREADS=16
OLLAMA_NUM_PARALLEL=1
OLLAMA_MAX_LOADED_MODELS=1
OLLAMA_MAX_QUEUE=64
# Optional Podman CPU controls. Leave empty for no container CPU restriction.
OLLAMA_CONTAINER_CPUS=
OLLAMA_CPUSET_CPUS=
HTTPS_PROXY=
NO_PROXY=127.0.0.1,localhost
